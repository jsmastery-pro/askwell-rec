{
  "name": "askwell",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @askwell/web dev",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p e2e",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "db:types": "pnpm dlx supabase@2.122.0 gen types typescript --project-id xpvgzgbmjvusbnteywkt --schema public > packages/db/types.ts.tmp && mv packages/db/types.ts.tmp packages/db/types.ts",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
