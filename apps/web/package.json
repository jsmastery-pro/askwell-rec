{
  "name": "@askwell/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm run widget",
    "dev": "next dev",
    "prebuild": "pnpm run widget",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit -p .",
    "test": "vitest run",
    "widget": "pnpm --filter @askwell/widget build && node -e \"const fs=require('node:fs');fs.mkdirSync('public',{recursive:true});fs.copyFileSync('../widget/dist/widget.js','public/widget.js')\""
  },
  "dependencies": {
    "@askwell/db": "workspace:*",
    "@askwell/shared": "workspace:*",
    "@clerk/nextjs": "^7.9.22",
    "@supabase/supabase-js": "^2.118.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@askwell/widget": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
